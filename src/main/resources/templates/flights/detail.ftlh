<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <title>Деталі рейсу</title>
</head>

<body>
    <h1>Рейс ${flight.flightNumber}</h1>
    <p>Звідки: ${flight.departureCity}</p>
    <p>Куди: ${flight.arrivalCity}</p>
    <p>Статус: ${flight.status}</p>
    <a href="/flights">Назад</a>
</body>

</html>